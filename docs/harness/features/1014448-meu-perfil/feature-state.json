  "decisions": [
    {
      "id": "creation-confirmation",
      "statement": "Mário Tinelli respondeu aprovo à prévia completa de Meu Perfil, nova Feature sem categoria. Busca no projeto encontrou somente Autenticação e Recuperação de Senha, que excluem esta capacidade.",
      "decided_by": "Mário Tinelli",
      "decided_at": "2026-09-10T11:03:04.045559Z",
      "status": "valid"
    },
    {
      "id": "q11",
      "statement": "Novo e-mail válido e não utilizado passa a valer imediatamente para login e recuperação, sem confirmação por e-mail.",
      "decided_by": "Mário Tinelli",
      "decided_at": "2026-09-10T11:09:58.572552Z",
      "status": "valid"
    },
    {
      "id": "q12",
      "statement": "Dados pessoais e troca de senha ficam em cards separados, cada um com seu componente e botão. As ações são independentes; a proposta de salvamento conjunto foi rejeitada.",
      "decided_by": "Mário Tinelli",
      "decided_at": "2026-09-10T11:09:58.572552Z",
      "status": "valid"
    },
    {
      "id": "q13",
      "statement": "Aplicar a mesma política de Recuperação de Senha: mínimo de 8 caracteres, maiúscula, minúscula, número, símbolo, rejeição de senhas conhecidas em vazamentos e confirmação idêntica.",
      "decided_by": "Mário Tinelli",
      "decided_at": "2026-09-10T11:09:58.572552Z",
      "status": "valid"
    },
    {
      "id": "q14",
      "statement": "Após trocar a senha, manter a sessão atual, encerrar as demais e remover Lembrar-me de todos os dispositivos.",
      "decided_by": "Mário Tinelli",
      "decided_at": "2026-09-10T11:09:58.572552Z",
      "status": "valid"
    },
    {
