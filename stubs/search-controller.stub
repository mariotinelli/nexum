<?php

declare(strict_types = 1);

namespace App\Http\Controllers\Search;

use App\Http\Resources\Search\{{ model }}Resource;
use App\Models\{{ model }};
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Pagination\LengthAwarePaginator;

class {{ pluralModel }}Controller extends BaseSearchController
{
    public function __invoke()
    {
        ${{ variable }} = $this->get{{ pluralModel }}();

        if (request()->has('selected') && !request()->has('page')) {
            ${{ variable }} = $this->getSelected({{ model }}::class, ${{ variable }});
        }

        return {{ model }}Resource::collection(${{ variable }});
    }

    protected function get{{ pluralModel }}(): LengthAwarePaginator
    {
        return {{ model }}::query()
            ->when(
                request()->has('search'),
                fn (Builder $query) => $query->where('{{ searchAttribute }}', 'like', '%' . request()->get('search') . '%')
            )
            ->when(
                request()->has('selected'),
                fn (Builder $query) => $query->whereNotIn('id', request()->get('selected'))
            )
            ->orderBy('{{ searchAttribute }}')
            ->paginate(10);
    }
}
