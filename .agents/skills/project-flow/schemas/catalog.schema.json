{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remsoft.tools/schemas/project-flow/catalog.schema.json",
  "title": "Product capability catalog metadata",
  "$defs": {
    "title_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces",
        "audiences",
        "audience_mode",
        "shared_public_rule",
        "confirmation"
      ],
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "WEB",
              "APP"
            ]
          },
          "uniqueItems": true
        },
        "audiences": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "audience_mode": {
          "enum": [
            "single",
            "aggregate",
            "multiple"
          ]
        },
        "shared_public_rule": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "confirmed_by",
            "confirmed_at"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_by": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "audiences",
        "name",
        "title",
        "visible_delivery",
        "user_result",
        "included",
        "boundary_reason"
      ],
      "properties": {
        "surface": {
          "enum": [
            "WEB",
            "APP"
          ]
        },
        "audiences": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\[\\]]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "visible_delivery": {
          "type": "string",
          "minLength": 1
        },
        "user_result": {
          "type": "string",
          "minLength": 1
        },
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "boundary_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "surface": {
                "const": "WEB"
              }
            }
          },
          "then": {
            "properties": {
              "audiences": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "surface": {
                "const": "APP"
              }
            }
          },
          "then": {
            "properties": {
              "audiences": {
                "not": {
                  "contains": {
                    "const": "BACKOFFICE"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "evidence",
        "evidence_kind",
        "audiences",
        "disposition",
        "owner",
        "consumers",
        "repository",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "locator"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "evidence_kind": {
          "enum": [
            "demonstrated",
            "annotation",
            "ambiguity"
          ]
        },
        "audiences": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "disposition": {
          "enum": [
            "covered",
            "existing-confirmed",
            "excluded",
            "pending"
          ]
        },
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "consumers": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence",
            "proposed_change"
          ],
          "properties": {
            "status": {
              "enum": [
                "absent",
                "partial",
                "existing",
                "unknown"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "proposed_change": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "decision": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement",
                "confirmed_by",
                "confirmed_at"
              ],
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed_by": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "covered"
              }
            }
          },
          "then": {
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "owner": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "excluded",
                  "existing-confirmed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement",
                  "confirmed_by",
                  "confirmed_at"
                ],
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confirmed_by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confirmed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "input_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "requested",
        "entries",
        "references"
      ],
      "properties": {
        "selection": {
          "enum": [
            "complete-package",
            "selected-files"
          ]
        },
        "requested": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "entries": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "origin",
              "role",
              "decision"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "behavioral",
                  "contextual",
                  "excluded",
                  "pending"
                ]
              },
              "decision": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "statement",
                      "confirmed_by",
                      "confirmed_at"
                    ],
                    "properties": {
                      "statement": {
                        "type": "string",
                        "minLength": 1
                      },
                      "confirmed_by": {
                        "type": "string",
                        "minLength": 1
                      },
                      "confirmed_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "references": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from_source",
              "target",
              "status",
              "source_id",
              "decision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "from_source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "included",
                  "excluded",
                  "pending"
                ]
              },
              "source_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "decision": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "statement",
                      "confirmed_by",
                      "confirmed_at"
                    ],
                    "properties": {
                      "statement": {
                        "type": "string",
                        "minLength": 1
                      },
                      "confirmed_by": {
                        "type": "string",
                        "minLength": 1
                      },
                      "confirmed_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "dependency_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "blocked_by",
        "provided_capability",
        "blocking_reason",
        "evidence"
      ],
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "blocked_by": {
          "type": "string",
          "minLength": 1
        },
        "provided_capability": {
          "type": "string",
          "minLength": 1
        },
        "blocking_reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "order_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "basis",
        "rationale",
        "evidence"
      ],
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "dependency",
            "confirmed-priority",
            "usage-lifecycle",
            "stable-id"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
