{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remsoft.tools/schemas/project-slices/change-review-state-v1.json",
  "title": "Project Slices semantic requirement change review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "review_id", "revisions", "decisions", "authorizations"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["pending", "approved", "rejected", "authorized"]},
    "review_id": {"$ref": "#/$defs/sha256"},
    "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/revision"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "authorizations": {"type": "array", "items": {"$ref": "#/$defs/authorization"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "impactItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_tasks", "unaffected_tasks",
        "affected_acceptance_criteria", "unaffected_acceptance_criteria",
        "affected_coverage", "unaffected_coverage",
        "affected_dependencies", "unaffected_dependencies"
      ],
      "properties": {
        "affected_tasks": {"type": "array", "items": {"$ref": "#/$defs/impactItem"}},
        "unaffected_tasks": {"type": "array", "items": {"$ref": "#/$defs/impactItem"}},
        "affected_acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/impactItem"}},
        "unaffected_acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/impactItem"}},
        "affected_coverage": {"type": "array", "items": {"$ref": "#/$defs/impactItem"}},
        "unaffected_coverage": {"type": "array", "items": {"$ref": "#/$defs/impactItem"}},
        "affected_dependencies": {"type": "array", "items": {"$ref": "#/$defs/impactItem"}},
        "unaffected_dependencies": {"type": "array", "items": {"$ref": "#/$defs/impactItem"}}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "before", "after", "rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "classification": {"enum": ["editorial", "functional"]},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number", "review_id", "recorded_by", "recorded_at", "reason", "baseline",
        "current_requirement", "classification", "summary", "changes", "impact",
        "preservation", "review_sha256"
      ],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "review_id": {"$ref": "#/$defs/sha256"},
        "recorded_by": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1},
        "baseline": {"$ref": "#/$defs/evidence"},
        "current_requirement": {"$ref": "#/$defs/evidence"},
        "classification": {"enum": ["editorial", "functional"]},
        "summary": {"type": "string", "minLength": 1},
        "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
        "impact": {"$ref": "#/$defs/impact"},
        "preservation": {"$ref": "#/$defs/evidence"},
        "review_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "review_sha256", "decision", "decided_by", "decided_at", "reason"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "review_sha256": {"$ref": "#/$defs/sha256"},
        "decision": {"enum": ["approved", "rejected"]},
        "decided_by": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "review_sha256", "affected_task_keys", "authorized_at"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "review_sha256": {"$ref": "#/$defs/sha256"},
        "affected_task_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "authorized_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
