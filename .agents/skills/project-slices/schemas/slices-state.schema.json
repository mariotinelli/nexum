{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remsoft.tools/schemas/project-slices/slices-state-v1.json",
  "title": "Project Slices local proposal and approval state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "current_revision", "revisions", "approvals"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["proposed", "approved"]},
    "current_revision": {"type": "integer", "minimum": 1},
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "recorded_by", "recorded_at", "reason", "proposal_sha256", "proposal"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "recorded_by": {"type": "string", "minLength": 1},
          "recorded_at": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1},
          "proposal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "proposal": {"$ref": "#/$defs/proposal"},
          "semantic_baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_sha256", "semantic_model_sha256", "semantic_model"],
            "properties": {
              "requirement_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "semantic_model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "semantic_model": {"type": "object"}
            }
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "proposal_sha256", "approved_by", "approved_at", "status"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "proposal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"},
          "status": {"enum": ["valid", "invalidated"]}
        }
      }
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "inspection", "requirements", "slices", "coverage", "decisions"],
      "properties": {
        "feature": {"type": "object"},
        "inspection": {"type": "array", "minItems": 1},
        "requirements": {"type": "array", "minItems": 1},
        "slices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "external_blockers": {
                "type": "array",
                "items": {"$ref": "#/$defs/externalBlocker"}
              },
              "description": {"$ref": "#/$defs/description"}
            }
          }
        },
        "coverage": {"type": "array", "minItems": 1},
        "decisions": {"type": "array"},
        "study_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/studyEvidence"}
        }
      }
    },
    "studyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_state_path", "study_revision", "study_publication_sha256", "study_remote_id", "question", "expected_result", "effort_limit", "result", "source", "authored_by", "authored_at", "recorded_by", "recorded_at", "result_sha256"],
      "properties": {
        "study_state_path": {"type": "string", "minLength": 1},
        "study_revision": {"type": "integer", "minimum": 1},
        "study_publication_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "study_remote_id": {"type": "integer", "minimum": 1},
        "question": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "effort_limit": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "reference": {"type": "string", "minLength": 1}
          }
        },
        "authored_by": {"type": "string", "minLength": 1},
        "authored_at": {"type": "string", "format": "date-time"},
        "recorded_by": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "externalBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "feature_issue_id", "feature_title", "capability", "blocking_reason", "source_slice_issue_id", "source_slice_title"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "feature_issue_id": {"type": "integer", "minimum": 1},
        "feature_title": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "blocking_reason": {"type": "string", "minLength": 1},
        "source_slice_issue_id": {"type": ["integer", "null"], "minimum": 1},
        "source_slice_title": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery", "limits", "criteria", "dependencies", "traceability"],
      "properties": {
        "delivery": {"type": "string", "minLength": 1},
        "limits": {"type": "string", "minLength": 1},
        "criteria": {"type": "array", "minItems": 1},
        "dependencies": {"type": "string", "minLength": 1},
        "technical_context": {"type": ["string", "null"], "minLength": 1},
        "traceability": {"type": "array", "minItems": 1}
      }
    }
  }
}
