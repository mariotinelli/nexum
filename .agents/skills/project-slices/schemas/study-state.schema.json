{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remsoft.tools/schemas/project-slices/study-state-v2.json",
  "title": "Project Slices exceptional Study state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "status_history", "revisions", "approvals", "operation", "result_history", "resumptions"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "status": {"enum": ["prepared", "approved", "publishing", "awaiting-confirmation", "awaiting-result", "result-recorded", "resumed"]},
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "recorded_at"],
        "properties": {
          "status": {"enum": ["prepared", "approved", "publishing", "awaiting-confirmation", "awaiting-result", "result-recorded", "resumed"]},
          "recorded_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "revisions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "publication_sha256", "approved_by", "approved_at", "role", "status"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "publication_sha256": {"$ref": "#/$defs/sha256"},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"},
          "role": {"const": "tech-lead"},
          "status": {"enum": ["valid", "invalidated"]}
        }
      }
    },
    "operation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "attempts", "observations", "status", "remote_id"],
          "properties": {
            "kind": {"const": "create"},
            "attempts": {"type": "array", "items": {"type": "object"}},
            "observations": {"type": "array", "items": {"type": "object"}},
            "status": {"enum": ["pending", "completed"]},
            "remote_id": {"type": ["integer", "null"], "minimum": 1}
          }
        }
      ]
    },
    "result_history": {"type": "array", "maxItems": 1, "items": {"type": "object"}},
    "resumptions": {"type": "array", "maxItems": 1, "items": {"type": "object"}},
    "readback": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "observed_at"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "observed_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "artifact": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "remote_id", "path", "sha256"],
          "properties": {
            "kind": {"const": "study"},
            "remote_id": {"type": "integer", "minimum": 1},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"required": ["readback", "artifact"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
