{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remsoft.tools/schemas/project-slices/divergence-state-v1.json",
  "title": "Project Slices material parent correction and alignment state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "status_history", "revisions", "decisions", "local_alignments", "operation", "readback", "completed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["pending", "rejected", "approved", "local-aligned", "aligning", "completed"]},
    "status_history": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "revisions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "local_alignments": {"type": "array", "maxItems": 1, "items": {"type": "object"}},
    "operation": {"type": ["object", "null"]},
    "readback": {"type": ["object", "null"]},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
